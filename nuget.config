<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only: the framework is consumed as any outside application would, and the Docker build sees the same feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
